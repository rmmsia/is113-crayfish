# Stage 1: build React
FROM node:20-alpine AS frontend
WORKDIR /app/client
RUN npm install -g npm@latest
COPY client/package*.json ./
RUN npm ci
COPY client/ ./
RUN npm run build

# Stage 2: production Express
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
COPY --from=frontend /app/client/dist ./client/dist

EXPOSE 3000
CMD ["node", "app.js"]