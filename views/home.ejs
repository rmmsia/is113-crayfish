<!DOCTYPE html>
<html lang="en">
<head>
    <title>Crayfish: Home</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <%- include('header') %>
    <nav class="site-nav">
        <a href="/posts?sort=top" class="<%= sort === 'top' ? 'active' : '' %>">TOP</a>
        <a href="/posts?sort=new" class="<%= sort === 'new' ? 'active' : '' %>">NEW</a>
        <a href="/posts?sort=author_asc" class="<%= sort === 'author_asc' ? 'active' : '' %>">AUTHOR A-Z</a>
        <a href="/posts?sort=author_desc" class="<%= sort === 'author_desc' ? 'active' : '' %>">AUTHOR Z-A</a>
        <a href="/posts/create" class="btn-submit">+ CREATE POST</a>
    </nav>
    <ol class="post-list">
        <% posts.forEach((post, i) => { %>
            <li class="post-card" data-id="<%= post.id %>">
                <div class="rank"># <%= i + 1 < 10 ? '0' : '' %><%= i + 1 %></div>

                <div class="voting-col">
                    <form action="/posts/<%= post.id %>/upvote" method="post">
                      <input type="hidden" value="/posts" name="route">
                      <button type="submit" class="up vote-btn" data-id="<%= post.id %>" data-dir="up" title="upvote">▲</button>
                    </form>
                    <span class="score" data-id="<%= post.id %>"><%= post.upvotes?.length - post.downvotes?.length %></span>
                    <form action="/posts/<%= post.id %>/downvote" method="post">
                      <input type="hidden" value="/posts" name="route">
                      <button type="submit" class="down vote-btn" data-id="<%= post.id %>" data-dir="down" title="downvote">▼</button>
                    </form>
                </div>

                <% if (post.imageURL) { %>
                    <a href="/posts/<%= post.id %>" class="post-thumbnail-link">
                        <img class="post-thumbnail" src="<%= post.imageURL %>" alt="<%= post.title %>" loading="lazy" />
                    </a>
                <% } %>

                <div class="post-body">
                    <a href="/posts/<%= post.id %>" class="post-title"><%= post.title %></a>
                    <div class="post-sub">
                        <span class="author">@<%= post.author %></span>
                        <span class="dot">·</span>
                        <span class="time"><%= post.createdAt.toDateString() %></span>
                        <span class="dot">·</span>
                        <a href="/posts/<%= post.id %>#comments" class="comments-link"><%= post.comments.length %> comment<%= post.comments.length === 1 ? '' : 's' %></a>
                    </div>
                </div>
            </li>
            <br><br>
        <% }) %>
    </ol>
</body>
</html>