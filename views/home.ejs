<!DOCTYPE html>
<html lang="en">
<head>
    <title>Crayfish: Home</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <%- include('header') %>
    <nav class="site-nav">
        <strong>SORT BY: </strong>
        <a href="/home?sort=top">TOP</a>
        <a href="/home?sort=new">NEW</a>
    </nav>
    <ol class="post-list">
        <% posts.forEach((post, i) => { %>
            <li class="post-card" data-id="<%= post.id %>">
                <div class="rank"># <%= i + 1 < 10 ? '0' : '' %><%= i + 1 %></div>

                <div class="voting-col">
                    <button class="up vote-btn" data-id="<%= post.id %>" data-dir="up" title="upvote">▲</button>
                    <span class="score" data-id="<%= post.id %>"><%= post.upvotes - post.downvotes %></span>
                    <button class="down vote-btn" data-id="<%= post.id %>" data-dir="down" title="downvote">▼</button>
                </div>

                <% if (post.imageURL) { %>
                    <a href="/posts/<%= post.id %>" class="post-thumbnail-link">
                        <img class="post-thumbnail" src="<%= post.imageURL %>" alt="<%= post.title %>" loading="lazy" />
                    </a>
                <% } %>

                <div class="post-body">
                    <a href="/posts/<%= post.id %>" class="post-title"><%= post.title %></a>
                    <div class="post-sub">
                        <span class="author">@<%= post.author %></span>
                        <span class="dot">·</span>
                        <span class="time"><%= post.createdAt.toDateString() %></span>
                        <span class="dot">·</span>
                        <a href="/posts/<%= post.id %>#comments" class="comments-link"><%= post.comments.length %> comment<%= post.comments.length === 1 ? '' : 's' %></a>
                    </div>
                </div>
            </li>
            <br><br>
        <% }) %>
    </ol>
</body>
</html>