<!DOCTYPE html>
<html lang="en">
<head>
  <title>Crayfish: Update Profile</title>
</head>
<body>
  <%- include('../header') %>
  <h1>Edit About</h1>
  
  <form action="/profile/update" method="post">
    <label for="about">About:</label><br>
    <textarea name="about" id="about" rows="10" cols="80"><%= user.about %></textarea><br>
    <input type="submit" value="Update">
  </form><br><br>
  <a href="/profile">&#x2190; Back to profile</a>

</body>
</html>