<!DOCTYPE html>
<html lang="en">
<head>
  <title>Crayfish: <%= user.username %>'s Profile</title>
</head>
<body>
  <%- include('../header') %>
  <div style="padding: 1em">
    <h1><%= user.username %></h1>
    
    <p>Joined: <%= new Date(user.createdAt).toLocaleDateString('en-GB') %> by invitation from <%= user.invitedBy %></p>
    <p>Karma: <%= totalKarma %></p>
    <p>Posts Submitted: <%= totalPosts %></p>
    <p>Comments Submitted: <%= totalComments %></p>
    <p>About: <%= user.about %></p>

    <% if (isUser) { %>
      <h2>Settings</h2>

      <a href="/profile/update">Update About</a><br><br>
      <a href="/invite">Invite New User</a><br><br>
      <a href="/logout">Logout</a>
      <br /><hr>
      <h2>My Posts</h2>
    <% } else { %>
      <br /><hr>
      <h2><%= user.username %><%= user.username[user.username.length - 1].toLowerCase() === 's' ? `'` : `'s` %> Posts</h2>
    <% } %>
    <div class="post-list">
      <% posts.reverse().forEach(post => { %>
        <li class="post-card" data-id="<%= post.id %>">
          <% if (post.imageURL) { %>
            <a href="/posts/<%= post.id %>" class="post-thumbnail-link">
              <img class="post-thumbnail" src="<%= post.imageURL %>" alt="<%= post.title %>" loading="lazy" />
            </a>
          <% } %>
          <div class="post-body">
            <a href="/posts/<%= post.id %>" class="post-title"><%= post.title %></a>
            <div class="post-sub">
              <span class="time"><%= post.createdAt.toDateString() %></span>
              <span class="dot">·</span>
              <a href="/posts/<%= post.id %>#comments" class="comments-link"><%= post.comments.length %> comment<%= post.comments.length === 1 ? '' : 's' %></a>
            </div>
          </div>
        </li>
        <br><br>
      <% }) %>
    </div>
  </div>
  <%- include('../footer') %>