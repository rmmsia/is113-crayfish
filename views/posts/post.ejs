<!DOCTYPE html>
<html lang="en">
<head>
  <% if (post) { %>
    <title>Crayfish: Post - <%= post.title %></title>
  <% } %>
</head>

<body>
  <%- include('../header') %>
  <main class="post-page">
    <div class="post-card">
      <div class="voting-col">
        <button class="up vote-btn" data-id="<%= post.id %>" data-dir="up" title="upvote">▲</button>
        <span class="score" data-id="<%= post.id %>"><%= post.upvotes - post.downvotes %></span>
        <button class="down vote-btn" data-id="<%= post.id %>" data-dir="down" title="downvote">▼</button>
      </div>

      <% if (post.imageURL) { %>
        <a href="/post/<%= post.id %>" class="post-thumbnail-link">
          <img class="post-thumbnail" src="<%= post.imageURL %>" alt="<%= post.title %>" loading="lazy" />
        </a>
      <% } %>

      <div class="post-body">
        <h3 class="post-title"><%= post.title %></h3>
        <div class="post-sub">
          <span class="author">@<%= post.author %></span>
          <span class="dot">·</span>
          <span class="time"><%= post.createdAt.toDateString() %></span>
          <span class="dot">·</span>
          <a href="/post/<%= post.id %>#comments" class="comments-link">0 comments</a>
        </div>
      </div>
    </div>
  </main>
</body>
</html>