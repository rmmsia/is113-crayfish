<%- include('../header') %>

<head>
    <title>Crayfish: Create Post</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>

<main>
    <h1>Edit Post</h1>
    
    <form action="/posts/<%= post._id %>/edit" method="POST" class="create-post-form">
        <div class="form-row">
            <label for="title">Title *</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required placeholder="Enter a title">
        </div>

        <div class="form-row">
            <label for="imageURL">Image URL</label>
            <input type="url" id="imageURL" name="imageURL" value="<%= post.imageURL %>" placeholder="https://example.com/image.jpg">
        </div>

        <div class="form-row align-top">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="5" placeholder="What's on your mind?"><%= post.description %></textarea>
        </div>

        <div class="form-group">
            <label>Tags</label>
            <div class="tags-container">
                <% if (tags.length > 0) { %>
                <label>Select tags: </label><br>
                <% tags.forEach(tag => { %>
                  <input type="checkbox" name="existingTags" value="<%= tag._id %>" <%= (post.tags || []).some(selectedTag => selectedTag._id.toString() === tag._id.toString()) ? 'checked' : '' %>>
                  <%= tag.name %><br>
                <% }) %>
              <% } %>                 

              <div class="form-group">
                  <label>Or create new tags: (comma seperated)</label>
                  <input type="text" placeholder="e.g. news,questions" name="newTags">
              </div>
            </div>
        </div>
          
    </div>

        <div class="form-row">
            <button type="submit">Update Post</button>
        </div>
    </form>
</main>