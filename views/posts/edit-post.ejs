<%- include('../header') %>

<head>
    <title>Crayfish: Create Post</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>

<main>
    <h1>Edit Post</h1>
    
    <form action="/posts/<%= post._id %>/edit" method="POST" class="create-post-form">
        <div class="form-row">
            <label for="title">Title *</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required placeholder="Enter a title">
        </div>

        <div class="form-row">
            <label for="imageURL">Image URL</label>
            <input type="url" id="imageURL" name="imageURL" value="<%= post.imageURL %>" placeholder="https://example.com/image.jpg">
        </div>

        <div class="form-row align-top">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="5" placeholder="What's on your mind?"><%= post.description %></textarea>
        </div>

        <div class="form-group">
            <label>Tags</label>
            <div class="tags-container">
                <% const availableTags=['News', 'Photography' , 'Help' , 'Question' , 'Discussion' ]; %>
                    <% availableTags.forEach(tag=> { %>
                        <div class="tag-checkbox">
                            <input type="checkbox" id="tag-<%= tag %>" name="tags" value="<%= tag %>">
                            <label for="tag-<%= tag %>">
                                <%= tag %>
                            </label>
                        </div>
                        <% }) %>
            </div>
        </div>

        <div class="form-row">
            <button type="submit">Update Post</button>
        </div>
    </form>
</main>