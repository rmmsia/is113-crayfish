<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crayfish: Forgot Password</title>
</head>
<body>
  <%- include('../header') %>
  <h1>Forgot Password</h1>

  <% if (error) { %>
    <p class="error">* <%= error %></p>
  <% } %>

  <form action="/forgot-password" method="POST">
    <input type="email" name="email" required placeholder="Enter your email" value="<%= email %>"><br>
    <button class="" type="submit">Reset Password</button>
  </form>

  <% if (resetLink) { %>
    <p>Use this link to reset your password: <a href="<%= resetLink %>"><%= resetLink %></a></p>
  <% } %>

  <%- include('../footer') %>
</body>
</html>