<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crayfish: Reset Password</title>
</head>
<body>
  <%- include('../header') %>
  <h3>Reset Password</h3>

  <% if (errors) { %>
    <ul class="error">
      <% errors.forEach(e => { %>
        <li><%= e %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/reset-password/<%= token %>" method="post">
    <input type="password" name="password" required placeholder="Enter new password" value="<%= password || '' %>">
    <button type="submit" class="btn-submit">Reset Password</button>
  </form>

  <%- include('../footer') %>
</body>
</html>