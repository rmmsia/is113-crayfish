<!DOCTYPE html>
<html lang="en">
<head>
  <title>Crayfish: User Tree</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('header') %>
  <main class="page-content">
    <h1>User Invite Tree</h1>
    <div class="user-tree">
      <%
      function renderTree(node, prefix, isLast, isRoot) {
        prefix = prefix || '';
        isLast = isLast !== undefined ? isLast : true;
        isRoot = isRoot || false;

        const connector = isRoot ? '' : (isLast ? '└── ' : '├── ');
      %>
        <div class="tree-node">
          <span class="tree-prefix"><%= prefix %><%= connector %></span><a href="/profile/u/<%= node.username %>" class="tree-username"><%= node.username %></a> <span class="tree-karma">(<%= node.karma %>)</span>
        </div>
      <%
        if (node.children && node.children.length > 0) {
          const newPrefix = isRoot ? '' : prefix + (isLast ? '    ' : '│   ');
          node.children.forEach(function(child, i) {
            renderTree(child, newPrefix, i === node.children.length - 1, false);
          });
        }
      }
      %>

      <% tree.forEach(function(root) { renderTree(root, '', true, true); }); %>
    </div>
  </main>
  <%- include('footer') %>
</body>
</html>